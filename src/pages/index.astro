---
import { resolveEdgeConfig, type EdgeEnv } from '../security/guardrails.js';
import { renderAppleGatewayHtml } from '../ui/gateway-page.js';

const env = (
  ((Astro.locals as unknown as Record<string, unknown>)?.runtime as { env?: EdgeEnv } | undefined)?.env || {}
) as EdgeEnv;
const config = resolveEdgeConfig(env, Astro.request);

const html = renderAppleGatewayHtml({
  mcpEndpoint: config.publicMcpUrl,
  docsUrl: config.docsUrl,
  portfolioUrl: config.portfolioUrl,
  version: config.version,
  edgeColo: config.edgeColo,
});
---

<Fragment set:html={html} />
