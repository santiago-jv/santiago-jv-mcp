---
import { renderAppleGatewayHtml } from '../ui/gateway-page.js';

const mcpEndpoint = 'https://mcp.santiago-jv.tech/mcp';
const docsUrl = '/docs';
const portfolioUrl = 'https://www.santiago-jv.tech';
const version = '1.0.0';

const cf = (Astro.request as any)?.cf;
const edgeColo = cf?.colo || 'IAD (Edge)';

const html = renderAppleGatewayHtml({
  mcpEndpoint,
  docsUrl,
  portfolioUrl,
  version,
  edgeColo,
});
---

<Fragment set:html={html} />
